{
  "name": "pi-mstack",
  "version": "0.4.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pstack",
    "agent-skills"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelasper/pi-mstack.git"
  },
  "homepage": "https://github.com/michaelasper/pi-mstack#readme",
  "bugs": {
    "url": "https://github.com/michaelasper/pi-mstack/issues"
  },
  "description": "Pinned pstack skills for Pi with native scheduling and delegation",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "generated/",
    "upstream/",
    "port/",
    "tools/",
    "scripts/",
    "tests/",
    "docs/",
    "LICENSE",
    "CHANGELOG.md",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/pstack/index.ts",
      "./extensions/pstack/context.ts"
    ],
    "skills": [
      "./generated/skills"
    ],
    "prompts": [
      "./extensions/pstack/prompts"
    ],
    "subagents": {
      "agents": [
        "./generated/agents"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/upstream.mjs check",
    "generate": "node tools/upstream.mjs generate",
    "upstream:propose": "node tools/upstream.mjs propose",
    "upstream:accept": "node tools/upstream.mjs accept",
    "upstream:repair": "node tools/upstream.mjs repair",
    "typecheck": "tsc",
    "upstream:export": "node tools/upstream.mjs export",
    "test:native": "node --test tests/native.test.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "node scripts/release.mjs pack",
    "release:verify": "node scripts/release.mjs verify",
    "prepack": "node tools/upstream.mjs check",
    "prepublishOnly": "node scripts/release.mjs check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@trevonistrevon/pi-loop": "0.7.19",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "pi-subagents": "0.88.1"
  }
}
